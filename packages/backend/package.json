{
  "name": "expenzo-backend",
  "version": "1.0.0",
  "description": "Expenzo expense tracker backend",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "NODE_OPTIONS='--no-deprecation' nest start",
    "start:dev": "NODE_OPTIONS='--no-deprecation' nest start --watch",
    "start:debug": "NODE_OPTIONS='--no-deprecation' nest start --debug --watch",
    "start:prod": "NODE_OPTIONS='--no-deprecation' node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "NODE_OPTIONS='--no-deprecation' typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "NODE_OPTIONS='--no-deprecation' typeorm-ts-node-commonjs -d src/data-source.ts migration:generate",
    "migration:run": "NODE_OPTIONS='--no-deprecation' typeorm-ts-node-commonjs -d src/data-source.ts migration:run",
    "migration:run:prod": "NODE_OPTIONS='--no-deprecation' typeorm -d dist/data-source.js migration:run",
    "migration:revert": "NODE_OPTIONS='--no-deprecation' typeorm-ts-node-commonjs -d src/data-source.ts migration:revert",
    "migration:create": "NODE_OPTIONS='--no-deprecation' typeorm-ts-node-commonjs -d src/data-source.ts migration:create",
    "db:drop": "npm run typeorm -- schema:drop && npm run typeorm -- query 'DROP TABLE IF EXISTS migrations CASCADE'",
    "db:fresh": "npm run db:drop && npm run migration:run"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "firebase-admin": "^12.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.0",
    "rxjs": "^7.8.0",
    "tsx": "^4.21.0",
    "typeorm": "^0.3.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "multer": "^2.1.1",
    "lodash": "^4.18.0",
    "qs": "^6.15.2",
    "protobufjs": "^7.5.8",
    "file-type": "^21.3.2",
    "glob": "^10.5.0",
    "picomatch": "^4.0.4",
    "ajv": "^8.18.0",
    "webpack": "^5.104.1",
    "tmp": "^0.2.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
