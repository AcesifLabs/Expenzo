<?xml version="1.0" encoding="UTF-8"?>

<mutations version="1.1">
  <directories>
    <directory recursive="true">lib/features/sms_parser/domain</directory>
  </directories>
  <exclude>
    
    <regex pattern="appLogger\.[a-z]+\([^;]*;" dotAll="true"/>
    <regex pattern="catch \([a-z, ]+\) \{\s*appLogger\.[a-z]+\([^;]*;" dotAll="true"/>
    <regex pattern="//[^\n]*"/>
    <regex pattern="import [^;]*;"/>
    
    <directory>lib/features/sms_parser/domain/entities/**</directory>
  </exclude>
  <commands>
    <command group="test" expected-return="0" working-directory="." timeout="300">flutter test test/features/sms_parser test/property/amount_parse_property_test.dart</command>
  </commands>

</mutations>
