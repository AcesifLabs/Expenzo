default_platform(:android)

platform :android do

  desc "Run tests"
  lane :test do
    sh "cd .. && flutter test"
  end

  desc "Build and upload to Play Store internal track"
  lane :beta do
    build_name = ENV["BUILD_NAME"]
    build_number = ENV["BUILD_NUMBER"]

    UI.user_error!("BUILD_NAME is required") if build_name.to_s.empty?
    UI.user_error!("BUILD_NUMBER is required") if build_number.to_s.empty?

    # Clean previous builds
    sh "cd .. && flutter clean"

    # Build the AAB
    sh "cd .. && flutter build appbundle --release --build-name #{build_name} --build-number #{build_number}"

    # Upload to Play Store internal track
    upload_to_play_store(
      track: "internal",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Promote internal build to production"
  lane :production do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      skip_upload_changelogs: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

end
